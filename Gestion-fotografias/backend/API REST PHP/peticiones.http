###############################################################################
# PETICIONES DE PRUEBA HTTP (VS Code REST Client / Postman)
###############################################################################
# Para ejecutar estas peticiones:
# 1. Instala la extensión "REST Client" en VS Code (humao.rest-client).
# 2. Inicia el servidor PHP desde la carpeta "public":
#      cd "backend/API REST PHP"
#      php -S localhost:8000 -t public
# 3. Haz clic en "Send Request" arriba de cada bloque.
###############################################################################

@url = http://localhost:8000

### 1. Ver especificación y estado de la API
GET {{url}}/

### 2. REGISTRO: Crear una cuenta de usuario nueva
POST {{url}}/registro
Content-Type: application/json

{
  "nombre": "Carlos Estudiante",
  "email": "carlos@utu.edu.uy",
  "clave": "clave123"
}

### 3. REGISTRO: Error de validación (datos incompletos) -> 400
POST {{url}}/registro
Content-Type: application/json

{
  "nombre": "Ab",
  "email": "correo-no-valido",
  "clave": "123"
}

### 4. LOGIN: Iniciar sesión como ADMINISTRADOR (recibe Cookie HttpOnly)
POST {{url}}/login
Content-Type: application/json

{
  "email": "admin@utu.edu.uy",
  "clave": "admin123"
}

### 5. LOGIN: Iniciar sesión como ALUMNO
POST {{url}}/login
Content-Type: application/json

{
  "email": "alumno@utu.edu.uy",
  "clave": "alumno123"
}

### 6. LOGIN: Contraseña incorrecta -> 401
POST {{url}}/login
Content-Type: application/json

{
  "email": "admin@utu.edu.uy",
  "clave": "clave-equivocada"
}

### 7. PERFIL: Consultar datos del usuario autenticado (usa la cookie HttpOnly)
GET {{url}}/perfil

### 8. PRODUCTOS: Listar catálogo completo (público)
GET {{url}}/productos

### 9. PRODUCTOS: Filtrar por categoría
GET {{url}}/productos?categoria=perifericos

### 10. PRODUCTOS: Ver detalle de un producto existente
GET {{url}}/productos/1

### 11. PRODUCTOS: Ver producto inexistente -> 404
GET {{url}}/productos/999

### 12. PRODUCTOS: Crear producto (requiere sesión 'auth')
POST {{url}}/productos
Content-Type: application/json

{
  "nombre": "Webcam Full HD 1080p",
  "descripcion": "Cámara web con micrófono estéreo integrado.",
  "precio": 1850.00,
  "stock": 25,
  "categoria": "perifericos"
}

### 13. PRODUCTOS: Error al crear con datos inválidos -> 400
POST {{url}}/productos
Content-Type: application/json

{
  "nombre": "X",
  "descripcion": "precio negativo",
  "precio": -100,
  "stock": "muchos",
  "categoria": ""
}

### 14. PRODUCTOS: Modificar precio y stock (PUT parcial)
PUT {{url}}/productos/1
Content-Type: application/json

{
  "precio": 2690.00,
  "stock": 15
}

### 15. PRODUCTOS: Probar regla del Setter (stock negativo corregido a 0)
PUT {{url}}/productos/1
Content-Type: application/json

{
  "stock": -50
}

### 16. PRODUCTOS: Vender unidades (descuenta stock en la BD)
POST {{url}}/productos/1/vender
Content-Type: application/json

{
  "cantidad": 2
}

### 17. PRODUCTOS: Vender más de lo que hay en stock -> 400
POST {{url}}/productos/1/vender
Content-Type: application/json

{
  "cantidad": 9999
}

### 18. PRODUCTOS: Crear producto con nombre repetido -> 400
POST {{url}}/productos
Content-Type: application/json

{
  "nombre": "Mouse inalámbrico",
  "descripcion": "Intento de duplicar",
  "precio": 890,
  "stock": 10,
  "categoria": "perifericos"
}

### 19. PRODUCTOS: Borrar producto que aún tiene stock -> 400 (regla del Servicio)
DELETE {{url}}/productos/1

### 20. PRODUCTOS: Borrar producto con stock 0 (solo ADMIN)
# Primero iniciar sesión como admin (Petición 4)
DELETE {{url}}/productos/4

### 21. PRODUCTOS: Intentar borrar con usuario común -> 403
# Iniciar sesión como alumno (Petición 5) y luego ejecutar:
DELETE {{url}}/productos/3

### 22. LOGOUT: Cerrar sesión (elimina la cookie HttpOnly)
POST {{url}}/logout

### 23. PERFIL tras logout -> 401
GET {{url}}/perfil

### 24. Ruta inexistente -> 404
GET {{url}}/no-existe
