# ========================================
# Cipher Forge - Variables de entorno (plantilla)
# ========================================
# Copiá este archivo a .env y completá los valores. NUNCA subas .env al repositorio.
# El docker-compose.yml exige MYSQL_ROOT_PASSWORD, MYSQL_PASSWORD, JWT_SECRET y FRONTEND_URL:
# si falta alguna, `docker compose up` falla a propósito (fail closed).
# En el servidor: chmod 600 .env
# ========================================

# --- Base de datos (obligatorias para el servicio db) ---
MYSQL_ROOT_PASSWORD=cambia_esta_clave_root
MYSQL_DATABASE=cipher_forge
MYSQL_USER=cipher_user
MYSQL_PASSWORD=cambia_esta_clave_app

# --- Firma de los JWT (obligatoria) ---
# Generá el valor con: openssl rand -hex 32
# C-01: la app ya NO acepta un secreto guardado en uploads/.jwt_secret; sin JWT_SECRET falla cerrada.
JWT_SECRET=pega_aqui_el_resultado_de_openssl_rand_hex_32

# --- URL pública del frontend (obligatoria) ---
# Debe usar el MISMO host que ve el navegador (SameSite=Strict).
# IMPORTANTE: debe apuntar a la carpeta que contiene frontend-cliente y
# frontend-fotografo. Los QR se arman como
# {FRONTEND_URL}/frontend-cliente/pages/... y {FRONTEND_URL}/frontend-fotografo/...
# Ej. Live Server: http://127.0.0.1:5501/Gestion-fotografias
# Ej. Nginx/dominio: https://tu-dominio
FRONTEND_URL=http://127.0.0.1:5501/Gestion-fotografias

# --- Aplicación (normalmente NO hace falta tocarlas; las define docker-compose.yml) ---
# DB_HOST=db
# DB_USER=cipher_user
# DB_PASS=            # se toma de MYSQL_PASSWORD (obligatoria)
# DB_NAME=cipher_forge
# DB_PORT=3306
# DB_CHARSET=utf8mb4

# --- Cookies de sesión (JWT) ---
# COOKIE_SECURE=true solo en producción (HTTPS); con HTTP dejar en false.
COOKIE_NAME=cipher_forge_token
COOKIE_SECURE=false
COOKIE_SAMESITE=Strict

# --- Sistema (H-01): CIDRs extra permitidos para /sistema/* (además de exigir sesión) ---
SISTEMA_ALLOWED_IPS=
