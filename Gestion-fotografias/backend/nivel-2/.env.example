# ======================================================================
# .env.example - PLANTILLA (esta SÍ se sube a git)
# ======================================================================
# Copiá este archivo a ".env" y poné tus propios valores:
#
#   cp .env.example .env          (Linux/Mac)
#   copy .env.example .env        (Windows)
#
# El .env real queda fuera de git; este ejemplo es el que le muestra a
# cualquiera que baje el proyecto QUÉ variables necesita, sin revelar
# ningún secreto de verdad.
# ======================================================================

# Generá la tuya con: php -r "echo bin2hex(random_bytes(32));"
SECRET_KEY=cambiame-por-una-clave-generada-al-azar

# Usá development mientras aprendés. En un servidor público usá production.
APP_ENV=development

TOKEN_LIFETIME=3600

# Debe coincidir exactamente con la dirección donde corre el frontend.
# Se usa para permitir cookies en las peticiones CORS del navegador.
FRONTEND_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_NAME=utu_demo
DB_USER=root
DB_PASSWORD=
