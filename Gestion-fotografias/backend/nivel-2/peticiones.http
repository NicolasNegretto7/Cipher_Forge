###############################################################
# PETICIONES DE EJEMPLO
###############################################################
# Para usar este archivo desde VS Code, instalá la extensión
# "REST Client" (humao.rest-client). Te aparece un botón
# "Send Request" arriba de cada pedido.
#
# Si no, copiá los mismos datos en Postman.
#
# Antes de empezar, levantá el servidor desde nivel-2:
#     php -S localhost:8000 index.php
#
# Si levantaste todo con Docker, nivel-2 está en el puerto 8002:
#     @url = http://localhost:8002
###############################################################

@url = http://localhost:8000


### 1. Ver la ayuda de la API
GET {{url}}/


### 2. LOGIN como administrador
# El servidor guarda el token en una cookie HttpOnly.
# REST Client conserva la cookie para los pedidos siguientes.
POST {{url}}/login
Content-Type: application/json

{
  "email": "admin@utu.edu.uy",
  "clave": "admin123"
}


### 3. LOGIN como usuario común
POST {{url}}/login
Content-Type: application/json

{
  "email": "alumno@utu.edu.uy",
  "clave": "alumno123"
}


### 4. LOGIN con la contraseña equivocada  -> 401
POST {{url}}/login
Content-Type: application/json

{
  "email": "admin@utu.edu.uy",
  "clave": "estanoes"
}


### 5. REGISTRO de una cuenta nueva
POST {{url}}/registro
Content-Type: application/json

{
  "nombre": "Nuevo Alumno",
  "email": "nuevo@utu.edu.uy",
  "clave": "clave123"
}


### 6. REGISTRO con datos mal  -> muestra la lista de errores
POST {{url}}/registro
Content-Type: application/json

{
  "nombre": "AB",
  "email": "esto-no-es-un-email",
  "clave": "123"
}


### 7. MI PERFIL (necesita la cookie creada por el login)
GET {{url}}/perfil


### 8. MI PERFIL sin iniciar sesión, o después del logout  -> 401
GET {{url}}/perfil


### 9. LISTAR todos los productos (no hace falta sesión)
GET {{url}}/productos


### 10. LISTAR filtrando por categoría
GET {{url}}/productos?categoria=perifericos


### 11. VER un producto
GET {{url}}/productos/3


### 12. VER un producto que no existe  -> 404
GET {{url}}/productos/999


### 13. CREAR un producto (necesita sesión)
POST {{url}}/productos
Content-Type: application/json

{
  "nombre": "Parlante bluetooth",
  "descripcion": "Parlante portátil con batería.",
  "precio": 2790,
  "stock": 15,
  "categoria": "audio"
}


### 14. CREAR sin iniciar sesión  -> 401
POST {{url}}/productos
Content-Type: application/json

{
  "nombre": "Producto pirata",
  "descripcion": "No se tendría que crear",
  "precio": 100,
  "stock": 1,
  "categoria": "otros"
}


### 15. CREAR con datos mal  -> lista de errores
POST {{url}}/productos
Content-Type: application/json

{
  "nombre": "X",
  "descripcion": "precio negativo y sin categoría",
  "precio": -50,
  "stock": "muchos",
  "categoria": ""
}


### 16. MODIFICAR solo el precio y el stock
PUT {{url}}/productos/1
Content-Type: application/json

{
  "precio": 2599,
  "stock": 20
}


### 17. PROBAR LA REGLA DEL SETTER
# Mandamos stock negativo... y el objeto lo guarda en 0.
# Mirá el método setStock() en models/Product.php
PUT {{url}}/productos/1
Content-Type: application/json

{
  "stock": -50
}


### 18. VENDER: descuenta stock
# Mirá el método sell() de services/ProductService.php:
# ahí están las reglas, y no hay una sola línea de HTTP.
POST {{url}}/productos/3/vender
Content-Type: application/json

{
  "cantidad": 2
}


### 19. VENDER más de lo que hay  -> lo frena el SERVICIO
POST {{url}}/productos/3/vender
Content-Type: application/json

{
  "cantidad": 9999
}


### 20. VENDER el producto 4, que tiene stock 0
POST {{url}}/productos/4/vender
Content-Type: application/json

{
  "cantidad": 1
}


### 21. CREAR un producto con un nombre que ya existe
# Otra regla del SERVICIO: el nombre no se puede repetir.
POST {{url}}/productos
Content-Type: application/json

{
  "nombre": "Auriculares",
  "descripcion": "repetido a propósito",
  "precio": 1000,
  "stock": 5,
  "categoria": "audio"
}


### 22. BORRAR un producto que todavía tiene stock
# Regla del SERVICIO: primero hay que vender la mercadería.
# (con la sesión del ADMIN, si no da 403 antes)
DELETE {{url}}/productos/2


### 23. BORRAR el producto 4 (stock 0)  -> SOLO ADMIN
# Probalo primero con la sesión del alumno -> 403
# Después con la sesión del admin           -> funciona
DELETE {{url}}/productos/4


### 24. CERRAR SESIÓN: elimina la cookie
POST {{url}}/logout


### 25. Una dirección que no existe  -> 404
GET {{url}}/cualquiercosa
